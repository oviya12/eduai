import json
import pandas as pd

FILE = "conversation.csv"                      # ← your CSV file
TOOL = "mcp__sdq__list_irl_workflow_listings"  # the tool we're checking

decoder = json.JSONDecoder()

def extract_events(cell):
    events, i, s = [], 0, str(cell)
    while i < len(s):
        start = s.find("{", i)
        if start == -1:
            break
        try:
            obj, end = decoder.raw_decode(s, start)
            if isinstance(obj, dict):
                events.append(obj)
            i = end
        except json.JSONDecodeError:
            i = start + 1
    return events

tool_ids = set()     # IDs of calls made to our tool
count = 0
df = pd.read_csv(FILE, dtype=str)

for _, row in df.iterrows():
    for cell in row:
        if not (isinstance(cell, str) and '"type"' in cell):
            continue
        for e in extract_events(cell):
            content = (e.get("message") or {}).get("content")
            if not isinstance(content, list):
                continue
            for b in content:
                # Remember every call to our tool
                if b.get("type") == "tool_use" and b.get("name") == TOOL:
                    tool_ids.add(b.get("id"))
                # Check results that belong to those calls
                if b.get("type") == "tool_result" and b.get("tool_use_id") in tool_ids:
                    count += 1
                    r = json.dumps(b.get("content"))
                    print(f"\n===== RESULT #{count} ({len(r)} chars) =====")
                    print("  contains 'source_url'?  ", "source_url" in r)
                    print("  contains 'example.com'? ", "example.com" in r)
                    print("  contains 'http'?        ", "http" in r)
                    print("  preview:", r[:400])

print(f"\nTotal results checked: {count}")
