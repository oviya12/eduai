import json, re
import pandas as pd

FILE = "conversation.csv"   # ← your CSV file name
SHOW_THINKING = False       # True = also show the AI's reasoning

decoder = json.JSONDecoder()

def extract_events(cell):
    """Pull every JSON object out of one cell, even if they're stuck together."""
    events, i, s = [], 0, str(cell)
    while i < len(s):
        start = s.find("{", i)
        if start == -1:
            break
        try:
            obj, end = decoder.raw_decode(s, start)
            if isinstance(obj, dict):
                events.append(obj)
            i = end
        except json.JSONDecodeError:
            i = start + 1
    return events

def show(e, seen):
    uid = e.get("uuid")
    if uid and uid in seen:          # skip duplicates
        return
    seen.add(uid)
    t = e.get("type")

    if t == "queue-operation" and e.get("operation") == "enqueue":
        print(f"\n{'='*60}\n🧑 USER: {e.get('content')}")
        return
    if t not in ("assistant", "user"):
        return
    content = (e.get("message") or {}).get("content")
    if not isinstance(content, list):
        return

    for b in content:
        kind = b.get("type")
        if kind == "thinking" and SHOW_THINKING:
            print(f"\n🤔 THINKING: {b.get('thinking', '')[:400]}")
        elif kind == "tool_use":
            print(f"\n🔧 TOOL CALL: {b.get('name')}  {json.dumps(b.get('input'))[:200]}")
        elif kind == "tool_result":
            r = json.dumps(b.get("content"))
            flag = "✅ has source_url" if "source_url" in r else "❌ NO source_url"
            print(f"📦 TOOL RESULT ({len(r)} chars) — {flag}")
            print(f"   {r[:250]}")
        elif kind == "text":
            text = b.get("text", "")
            print(f"\n🤖 ANSWER:\n{text}")
            for name, url in re.findall(r"\[([^\]]+)\]\(([^)]+)\)", text):
                bad = "example.com" in url or "source_url" in url
                print(f"   🔗 {name} -> {url}  {'❌ FAKE LINK' if bad else ''}")

df = pd.read_csv(FILE, dtype=str)
seen = set()
for row_num, row in df.iterrows():
    for col in df.columns:
        cell = row[col]
        if isinstance(cell, str) and '"type"' in cell:   # only cells with log JSON
            for e in extract_events(cell):
                show(e, seen)
